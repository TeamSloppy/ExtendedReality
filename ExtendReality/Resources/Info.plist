<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ExtendReality</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>xr.sloppy.team.ExtendReality.maps</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>extendreality</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>xr.sloppy.team.ExtendReality.google-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(YOUTUBE_OAUTH_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ExtendRealityPWACatalogURL</key>
	<string>https://xr.sloppy.team/plugins/catalog.json</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_rfb._tcp.</string>
		<string>_extend-reality._tcp.</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>ExtendReality uses the camera for private on-device hand controls and lets you grant selected web apps camera access.</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>ExtendReality reads whether Focus is active so spatial apps can respect your availability.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>ExtendReality reads your steps, active energy, and heart rate to show a private activity summary.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ExtendReality connects to your Mac and Sloppy Core on the local network for remote desktop and voice-assistant sessions.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ExtendReality uses your location while the app is open to provide location-aware spatial apps.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ExtendReality can listen on device for the Sloppy wake word while the app is open, record your Voice Mode requests, and let you grant selected web apps microphone access.</string>
	<key>NSMotionUsageDescription</key>
	<string>ExtendReality uses motion data from compatible AirPods to keep virtual windows stable while you move your head.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ExtendReality saves screenshots and recordings of the glasses display to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ExtendReality displays your photo and video library in the glasses workspace.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>ExtendReality uses on-device speech recognition to detect the Sloppy wake word while the app is open and to transcribe local Voice Mode input.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Phone</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).PhoneSceneDelegate</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>External Display</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).ExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>YouTubeOAuthCallbackScheme</key>
	<string>$(YOUTUBE_OAUTH_REVERSED_CLIENT_ID)</string>
	<key>YouTubeOAuthClientID</key>
	<string>$(YOUTUBE_OAUTH_CLIENT_ID)</string>
</dict>
</plist>
